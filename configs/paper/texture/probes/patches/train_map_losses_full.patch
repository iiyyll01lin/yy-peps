+def _map_groups(
+    prediction: torch.Tensor,
+    target: torch.Tensor,
+    channels_per_map: int,
+):
+    """Split packed texture channels into per-map groups, or None if ragged."""
+
+    if prediction.shape != target.shape:
+        raise ValueError("prediction and target must have the same shape")
+    channels = int(prediction.shape[-1])
+    if channels_per_map <= 0 or channels % channels_per_map != 0:
+        return None
+    groups = channels // channels_per_map
+    error = (prediction - target).abs().reshape(-1, groups, channels_per_map)
+    return error.mean(dim=(0, 2)), groups
+
+
+def per_map_l1_loss(
+    prediction: torch.Tensor,
+    target: torch.Tensor,
+    *,
+    channels_per_map: int = 3,
+    epsilon: float = 1e-8,
+) -> torch.Tensor:
+    """L1 reduced per map and normalised by each map's own current error.
+
+    Every map occupies exactly three channels, so the global reduction already
+    weights each map's mean absolute error equally. Dividing by the detached
+    per-map magnitude instead equalises RELATIVE progress, which hands more
+    gradient to maps that are already accurate. This is the log-domain reading
+    of L1, and it is the reduction that matches the per-map PSNR metric.
+    """
+
+    split = _map_groups(prediction, target, channels_per_map)
+    if split is None:
+        return nn.functional.l1_loss(prediction, target)
+    per_map, _ = split
+    scale = per_map.detach().clamp_min(epsilon)
+    return (per_map / scale).mean()
+
+
+def sqrt_map_l1_loss(
+    prediction: torch.Tensor,
+    target: torch.Tensor,
+    *,
+    channels_per_map: int = 3,
+    epsilon: float = 1e-8,
+) -> torch.Tensor:
+    """Half-strength normalisation, midway between global and fully per-map.
+
+    Included to test whether the effect is monotone in normalisation strength
+    rather than a property of one specific reduction.
+    """
+
+    split = _map_groups(prediction, target, channels_per_map)
+    if split is None:
+        return nn.functional.l1_loss(prediction, target)
+    per_map, _ = split
+    scale = per_map.detach().clamp_min(epsilon).sqrt()
+    return (per_map / scale).mean()
+
+
+def range_map_l1_loss(
+    prediction: torch.Tensor,
+    target: torch.Tensor,
+    *,
+    channels_per_map: int = 3,
+    epsilon: float = 1e-8,
+) -> torch.Tensor:
+    """L1 with each map divided by its target's dynamic range.
+
+    A static, data-derived reweighting rather than an adaptive one: the
+    coefficients do not depend on the current error. Separates "maps live on
+    different scales" from "already-accurate maps deserve more gradient".
+    """
+
+    split = _map_groups(prediction, target, channels_per_map)
+    if split is None:
+        return nn.functional.l1_loss(prediction, target)
+    per_map, groups = split
+    packed = target.reshape(-1, groups, channels_per_map)
+    span = packed.amax(dim=(0, 2)) - packed.amin(dim=(0, 2))
+    return (per_map / span.detach().clamp_min(epsilon)).mean()
+
+
