{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hip_benchmark_receipt.schema.json",
  "title": "Integrated HIP benchmark receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "benchmark_kind",
    "method",
    "mode",
    "implementation",
    "precision",
    "timing",
    "isa",
    "compiled_target",
    "git_sha",
    "gpu_name",
    "runtime_version",
    "driver_version",
    "wave_size",
    "compute_units",
    "output_width",
    "output_height",
    "grid_width",
    "grid_height",
    "feature_dim",
    "num_frequencies",
    "selected_feature_dim",
    "hidden_dim",
    "hidden_layers",
    "out_dim",
    "activation",
    "warmup",
    "iters",
    "median_ms",
    "p95_ms",
    "mean_ms",
    "stddev_ms",
    "min_ms",
    "max_ms",
    "paper_reference_ms",
    "paper_reference_source",
    "comparable_to_paper",
    "checksum"
  ],
  "properties": {
    "schema_version": {"const": 3},
    "benchmark_kind": {"const": "integrated_paper_workload"},
    "method": {
      "enum": [
        "bi-grid",
        "grid-peps-3f",
        "grid-pink-peps-3f",
        "grid-pink-peps-4f"
      ]
    },
    "mode": {"enum": ["baseline", "peps", "pink"]},
    "implementation": {"const": "fused_rocwmma_fp16"},
    "precision": {"const": "fp16_fp32_accumulate"},
    "timing": {"const": "hip_events"},
    "isa": {"type": "string", "pattern": "^gfx[0-9a-f]+.*$"},
    "compiled_target": {"type": "string", "minLength": 1},
    "git_sha": {"type": "string", "minLength": 1},
    "gpu_name": {"type": "string", "minLength": 1},
    "runtime_version": {"type": "integer", "minimum": 1},
    "driver_version": {"type": "integer", "minimum": 1},
    "wave_size": {"type": "integer", "minimum": 1},
    "compute_units": {"type": "integer", "minimum": 1},
    "compute_units_semantics": {"type": "string", "minLength": 1},
    "output_width": {"type": "integer", "minimum": 2},
    "output_height": {"type": "integer", "minimum": 2},
    "grid_width": {"const": 1024},
    "grid_height": {"const": 1024},
    "feature_dim": {"const": 16},
    "num_frequencies": {"type": "integer", "minimum": 0, "maximum": 4},
    "selected_feature_dim": {"type": "integer", "minimum": 1},
    "hidden_dim": {"const": 64},
    "hidden_layers": {"const": 3},
    "out_dim": {"const": 3},
    "activation": {"const": "gelu"},
    "warmup": {"type": "integer", "minimum": 1},
    "iters": {"type": "integer", "minimum": 2},
    "median_ms": {"type": "number", "exclusiveMinimum": 0},
    "p95_ms": {"type": "number", "exclusiveMinimum": 0},
    "mean_ms": {"type": "number", "exclusiveMinimum": 0},
    "stddev_ms": {"type": "number", "minimum": 0},
    "min_ms": {"type": "number", "exclusiveMinimum": 0},
    "max_ms": {"type": "number", "exclusiveMinimum": 0},
    "paper_reference_ms": {"type": "number", "exclusiveMinimum": 0},
    "paper_reference_source": {"const": "arXiv:2604.24167v1"},
    "comparable_to_paper": {"const": false},
    "checksum": {"type": "number"}
  }
}
